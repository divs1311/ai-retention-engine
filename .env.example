# Copy to .env and fill in what you need. Everything is optional.

# --- LLM providers (auto-detected; Anthropic is preferred when both are set) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# RE_LLM__PROVIDER=auto            # auto | anthropic | openai | template
# RE_LLM__ANTHROPIC_MODEL=claude-haiku-5-5
# RE_LLM__OPENAI_MODEL=gpt-5.4-mini

# --- API ---
# RE_API_KEY=change-me             # if set, /v1/* requires an X-API-Key header

# --- Simulation ---
# RE_SIMULATION__N_USERS=6000
# RE_SIMULATION__SEED=42

# --- Churn definition ---
# RE_CHURN__HORIZON_DAYS=30
# RE_CHURN__ACTIVE_WINDOW_DAYS=30
# RE_CHURN__HIGH_RISK_THRESHOLD=0.6

# --- Paths ---
# RE_DATA_DIR=./data
# RE_ARTIFACTS_DIR=./artifacts
# RE_LOG_LEVEL=INFO
